{
  "name": "civ-server",
  "description": "Civis game server — Bevy-based simulation with JSON-RPC API",
  "command": "cargo run -p civ-server",
  "cwd": "/Users/kooshapari/CodeProjects/Phenotype/repos/Civis",
  "env": {
    "RUST_LOG": "info",
    "CIVIS_PORT": "3001"
  },
  "health_check": {
    "type": "http",
    "url": "http://localhost:3001/health",
    "interval_secs": 30,
    "timeout_secs": 5,
    "retries": 3
  },
  "restart": "on-failure",
  "restart_secs": 5,
  "max_restarts": 5,
  "depends_on": [],
  "tags": ["game", "server", "rust"]
}
