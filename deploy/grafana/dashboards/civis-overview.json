        {
            "title": "OTLP Trace Latency",
            "type": "heatmap",
            "datasource": {
                "type": "tempo",
                "uid": "${DS_TEMPO}"
            },
            "gridPos": {
                "h": 8,
                "w": 24,
                "x": 0,
                "y": 16
            },
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "scheme",
                        "scheme": "Blues"
                    },
                    "custom": {
                        "hideFrom": {
                            "legend": false,
                            "tooltip": false,
                            "viz": false
                        },
                        "scaleDistribution": {
                            "type": "log",
                            "log": 2
                        }
                    },
                    "mappings": [],
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "blue",
                                "value": null
                            },
                            {
                                "color": "yellow",
                                "value": 200
                            },
                            {
                                "color": "red",
                                "value": 500
                            }
                        ]
                    },
                    "unit": "ms"
                },
                "overrides": []
            },
            "options": {
                "calculate": false,
                "cellGap": 1,
                "color": {
                    "mode": "scheme",
                    "scheme": "Blues",
                    "fill": "dark-orange",
                    "scale": "exponential",
                    "exponent": 0.5
                },
                "exemplars": {
                    "color": "rgba(255,0,255,0.7)"
                },
                "filterValues": {
                    "le": 1e-9
                },
                "legend": {
                    "show": true
                },
                "rowsFrame": {
                    "layout": "le"
                },
                "tooltip": {
                    "mode": "single",
                    "showColorScale": true,
                    "yHistogram": false
                },
                "yAxis": {
                    "axisLabel": "Duration",
                    "axisPlacement": "left",
                    "axisWidth": "auto",
                    "group": "default",
                    "reverse": false
                }
            },
            "targets": [
                {
                    "datasource": {
                        "type": "tempo",
                        "uid": "${DS_TEMPO}"
                    },
                    "queryType": "traceToMetrics",
                    "query": "span_name=~\"civis.*\"",
                    "refId": "A"
                }
            ]
        }
    ],
