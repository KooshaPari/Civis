

/// Famine severity given a per-tick `food_deficit` (calories short of need) and
/// the `population` consuming food. Returns `(severity, deaths_per_tick)`, both
/// clamped to finite non-negative ranges. Pure and deterministic.
pub fn famine_severity(food_deficit: f32, population: f32) -> (f32, u32) {
    if !food_deficit.is_finite() || !population.is_finite() {
        return (0.0, 0);
    }
    let deficit = food_deficit.max(0.0);
    let pop = population.max(0.0);
    if pop == 0.0 || deficit == 0.0 {
        return (0.0, 0);
    }
    // Severity scales with deficit-per-capita, saturating at 1.0.
    let per_capita = deficit / (pop + 1.0);
    let severity = (per_capita / (per_capita + 1.0)).clamp(0.0, 1.0);
    // Deaths per tick scale with severity * population, rounded to u32.
    let deaths = (severity * pop).round().max(0.0) as u32;
    (severity, deaths)
}

/// Disease spread rate in `[0,1]` as a function of `density` (people per cell,
/// already normalized to a reasonable band) and `trade_connectivity` (also
/// normalized to ~`[0,1]`). Multiplicative logistic blend, NaN-guarded.
pub fn disease_spread_rate(density: f32, trade_connectivity: f32) -> f32 {
    if !density.is_finite() || !trade_connectivity.is_finite() {
        return 0.0;
    }
    let d = density.clamp(0.0, 1.0);
    let t = trade_connectivity.clamp(0.0, 1.0);
    // Combined pressure in [0, 5], passed through logistic -> [0, 1].
    let pressure = d * 3.0 + t * 2.0;
    1.0 / (1.0 + (-pressure).exp())
}

/// Migration pressure in `[0,1]` driven by `local_scarcity` and
/// `neighbor_opportunity` (both expected in `[0,1]`). Higher when scarcity and
/// opportunity agree; smaller when they do not. NaN-guarded.
pub fn migration_pressure(local_scarcity: f32, neighbor_opportunity: f32) -> f32 {
    if !local_scarcity.is_finite() || !neighbor_opportunity.is_finite() {
        return 0.0;
    }
    let s = local_scarcity.clamp(0.0, 1.0);
    let o = neighbor_opportunity.clamp(0.0, 1.0);
    // Geometric-style blend saturates as both rise, drops if either is zero.
    let combined = (s * o).sqrt();
    (combined).clamp(0.0, 1.0)
}

#[cfg(test)]
mod append_only_tests {
    use super::*;

    #[test]
    fn famine_severity_zero_when_fed() {
        assert_eq!(famine_severity(0.0, 100.0), (0.0, 0));
    }

    #[test]
    fn famine_severity_zero_when_no_population() {
        assert_eq!(famine_severity(50.0, 0.0), (0.0, 0));
    }

    #[test]
    fn famine_severity_monotonic_in_deficit() {
        let (mild, _) = famine_severity(10.0, 100.0);
        let (severe, _) = famine_severity(1000.0, 100.0);
        assert!(mild > 0.0 && mild < severe);
        assert!(severe <= 1.0);
    }

    #[test]
    fn famine_severity_nan_guarded() {
        assert_eq!(famine_severity(f32::NAN, 100.0), (0.0, 0));
        assert_eq!(famine_severity(10.0, f32::NAN), (0.0, 0));
    }

    #[test]
    fn famine_severity_negative_inputs_clamped() {
        let (_, deaths) = famine_severity(-100.0, 100.0);
        assert_eq!(deaths, 0);
    }

    #[test]
    fn disease_spread_rate_bounds() {
        assert_eq!(disease_spread_rate(0.0, 0.0), 0.0);
        assert!((disease_spread_rate(1.0, 1.0) - 1.0).abs() < 1e-6);
        let mid = disease_spread_rate(0.5, 0.5);
        assert!(mid > 0.0 && mid < 1.0);
    }

    #[test]
    fn disease_spread_rate_clamps_inputs() {
        let clamped = disease_spread_rate(5.0, -3.0);
        let in_range = disease_spread_rate(1.0, 0.0);
        assert!((clamped - in_range).abs() < 1e-6);
    }

    #[test]
    fn disease_spread_rate_nan_guarded() {
        assert_eq!(disease_spread_rate(f32::NAN, 0.5), 0.0);
        assert_eq!(disease_spread_rate(0.5, f32::NAN), 0.0);
    }

    #[test]
    fn migration_pressure_bounds_and_shape() {
        assert_eq!(migration_pressure(0.0, 1.0), 0.0);
        assert_eq!(migration_pressure(1.0, 1.0), 1.0);
        let mid = migration_pressure(0.5, 0.5);
        assert!(mid > 0.0 && mid < 1.0);
    }

    #[test]
    fn migration_pressure_nan_guarded() {
        assert_eq!(migration_pressure(f32::NAN, 0.5), 0.0);
        assert_eq!(migration_pressure(0.5, f32::NAN), 0.0);
    }
}
