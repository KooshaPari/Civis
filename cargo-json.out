Terraform {"},{"highlight_end":34,"highlight_start":1,"text":"        /// Which op was applied."},{"highlight_end":25,"highlight_start":1,"text":"        op: TerraformOp,"},{"highlight_end":55,"highlight_start":1,"text":"        /// Number of voxel writes actually performed."},{"highlight_end":21,"highlight_start":1,"text":"        writes: u32,"},{"highlight_end":7,"highlight_start":1,"text":"    },"},{"highlight_end":48,"highlight_start":1,"text":"    /// A MATERIAL verb stamped N voxel writes."},{"highlight_end":15,"highlight_start":1,"text":"    Material {"},{"highlight_end":34,"highlight_start":1,"text":"        /// Which op was applied."},{"highlight_end":24,"highlight_start":1,"text":"        op: MaterialOp,"},{"highlight_end":55,"highlight_start":1,"text":"        /// Number of voxel writes actually performed."},{"highlight_end":21,"highlight_start":1,"text":"        writes: u32,"},{"highlight_end":7,"highlight_start":1,"text":"    },"},{"highlight_end":49,"highlight_start":1,"text":"    /// A LIFE verb injected one or more agents."},{"highlight_end":11,"highlight_start":1,"text":"    Life {"},{"highlight_end":57,"highlight_start":1,"text":"        /// For `SpawnOrganism` / `SpawnHerd`, the first"},{"highlight_end":57,"highlight_start":1,"text":"        /// `hecs::Entity` bits of the new agent(s). For"},{"highlight_end":63,"highlight_start":1,"text":"        /// `Bless` / `Curse` / `Heal`, the entity bits of the"},{"highlight_end":65,"highlight_start":1,"text":"        /// first affected agent (0 if the footprint was empty)."},{"highlight_end":66,"highlight_start":1,"text":"        /// For `Extinct`, the entity bits of the first despawned"},{"highlight_end":31,"highlight_start":1,"text":"        /// agent (0 if none)."},{"highlight_end":32,"highlight_start":1,"text":"        agent_entity_bits: u64,"},{"highlight_end":64,"highlight_start":1,"text":"        /// For `SpawnHerd` this is the count of agents spawned"},{"highlight_end":66,"highlight_start":1,"text":"        /// (always 1 for `SpawnOrganism`). For `Extinct` this is"},{"highlight_end":65,"highlight_start":1,"text":"        /// the count of agents despawned. For `Bless` / `Curse`"},{"highlight_end":56,"highlight_start":1,"text":"        /// / `Heal` this is the count of agents in the"},{"highlight_end":47,"highlight_start":1,"text":"        /// footprint whose state was touched."},{"highlight_end":29,"highlight_start":1,"text":"        affected_count: u32,"},{"highlight_end":7,"highlight_start":1,"text":"    },"},{"highlight_end":31,"highlight_start":1,"text":"    /// A DISASTER verb fired."},{"highlight_end":15,"highlight_start":1,"text":"    Disaster {"},{"highlight_end":45,"highlight_start":1,"text":"        /// `DisasterKind` that was applied."},{"highlight_end":28,"highlight_start":1,"text":"        kind: DisasterKind,"},{"highlight_end":57,"highlight_start":1,"text":"        /// `true` when the disaster actually triggered."},{"highlight_end":21,"highlight_start":1,"text":"        fired: bool,"},{"highlight_end":7,"highlight_start":1,"text":"    },"},{"highlight_end":56,"highlight_start":1,"text":"    /// A DISASTER verb that uses a custom Phase 4 path"},{"highlight_end":63,"highlight_start":1,"text":"    /// (Lightning / Tornado / VolcanicVent / Drought) without"},{"highlight_end":64,"highlight_start":1,"text":"    /// routing through `DisasterKind`. The receipt reports the"},{"highlight_end":60,"highlight_start":1,"text":"    /// voxel-write count so the Bevy HUD can show the same"},{"highlight_end":55,"highlight_start":1,"text":"    /// \"verb mutated the field\" toast it does for the"},{"highlight_end":35,"highlight_start":1,"text":"    /// standard Disaster receipt."},{"highlight_end":28,"highlight_start":1,"text":"    EnvironmentalDisaster {"},{"highlight_end":57,"highlight_start":1,"text":"        /// Wire-stable verb label, e.g. `\"lightning\"` /"},{"highlight_end":59,"highlight_start":1,"text":"        /// `\"tornado\"` / `\"volcanic_vent\"` / `\"drought\"`."},{"highlight_end":28,"highlight_start":1,"text":"        kind_label: String,"},{"highlight_end":60,"highlight_start":1,"text":"        /// Number of substrate cells the verb wrote (voxel"},{"highlight_end":62,"highlight_start":1,"text":"        /// writes for the first three; weather cells mutated"},{"highlight_end":26,"highlight_start":1,"text":"        /// for drought)."},{"highlight_end":21,"highlight_start":1,"text":"        writes: u32,"},{"highlight_end":7,"highlight_start":1,"text":"    },"},{"highlight_end":56,"highlight_start":1,"text":"    /// A LAW verb applied. Phase 4 (FR-CIV-GODTOOL-901"},{"highlight_end":62,"highlight_start":1,"text":"    /// batch 3) reports the scalar delta applied so the Bevy"},{"highlight_end":48,"highlight_start":1,"text":"    /// deck can show a \"policy applied\" toast."},{"highlight_end":10,"highlight_start":1,"text":"    Law {"},{"highlight_end":45,"highlight_start":1,"text":"        /// Verb id, e.g. `\"law.tax_bias\"` /"},{"highlight_end":40,"highlight_start":1,"text":"        /// `\"law.religion_pressure\"` /"},{"highlight_end":37,"highlight_start":1,"text":"        /// `\"law.difficulty_knob\"`."},{"highlight_end":22,"highlight_start":1,"text":"        verb: String,"},{"highlight_end":59,"highlight_start":1,"text":"        /// Scalar delta the verb applied to the substrate"},{"highlight_end":59,"highlight_start":1,"text":"        /// (joules transferred for tax_bias, belief units"},{"highlight_end":54,"highlight_start":1,"text":"        /// added for religion_pressure, new scarcity"},{"highlight_end":45,"highlight_start":1,"text":"        /// multiplier for difficulty_knob)."},{"highlight_end":20,"highlight_start":1,"text":"        delta: i64,"},{"highlight_end":7,"highlight_start":1,"text":"    },"},{"highlight_end":49,"highlight_start":1,"text":"    /// An INSPECT verb returned a probe report."},{"highlight_end":14,"highlight_start":1,"text":"    Inspect {"},{"highlight_end":49,"highlight_start":1,"text":"        /// The probed report (read-only state)."},{"highlight_end":29,"highlight_start":1,"text":"        report: ProbeReport,"},{"highlight_end":7,"highlight_start":1,"text":"    },"},{"highlight_end":61,"highlight_start":1,"text":"    /// Read-only / time / camera verb — no substrate write."},{"highlight_end":11,"highlight_start":1,"text":"    NoOp {"},{"highlight_end":45,"highlight_start":1,"text":"        /// Verb id for logging / HUD toast."},{"highlight_end":22,"highlight_start":1,"text":"        verb: String,"},{"highlight_end":7,"highlight_start":1,"text":"    },"},{"highlight_end":2,"highlight_start":1,"text":"}"}]}],"code":null}}
